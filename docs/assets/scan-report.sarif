{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "SolSentry",
          "version": "1.0.0",
          "informationUri": "https://github.com/Yaokunliang/solsentry",
          "rules": [
            {
              "id": "SS-101",
              "name": "Reentrancy",
              "shortDescription": {
                "text": "Reentrancy"
              },
              "fullDescription": {
                "text": "函数在外部调用之后仍写入合约状态，攻击者可在状态更新前重入该函数，重复提取资金或破坏账本一致性。"
              },
              "helpUri": "https://swcregistry.io/docs/SWC-107",
              "properties": {
                "tags": [
                  "security",
                  "solidity",
                  "SWC-107",
                  "CWE-841"
                ],
                "precision": "medium"
              }
            },
            {
              "id": "SS-102",
              "name": "tx.originAuthentication",
              "shortDescription": {
                "text": "tx.origin Authentication"
              },
              "fullDescription": {
                "text": "使用 tx.origin 进行身份校验会绕过中间合约的意图，钓鱼合约可诱导受害者触发调用并继承其权限。"
              },
              "helpUri": "https://swcregistry.io/docs/SWC-115",
              "properties": {
                "tags": [
                  "security",
                  "solidity",
                  "SWC-115",
                  "CWE-284"
                ],
                "precision": "medium"
              }
            },
            {
              "id": "SS-103",
              "name": "UncheckedLow-LevelCall",
              "shortDescription": {
                "text": "Unchecked Low-Level Call"
              },
              "fullDescription": {
                "text": "低级调用 call/send 返回的布尔值未被检查，调用失败时交易仍会继续执行，可能造成状态与资金不一致。"
              },
              "helpUri": "https://swcregistry.io/docs/SWC-104",
              "properties": {
                "tags": [
                  "security",
                  "solidity",
                  "SWC-104",
                  "CWE-252"
                ],
                "precision": "medium"
              }
            },
            {
              "id": "SS-104",
              "name": "DelegatecalltoDynamicTarget",
              "shortDescription": {
                "text": "Delegatecall to Dynamic Target"
              },
              "fullDescription": {
                "text": "delegatecall 的目标来自参数或可变状态，攻击者可控制执行逻辑并在当前合约上下文中改写存储。"
              },
              "helpUri": "https://swcregistry.io/docs/SWC-112",
              "properties": {
                "tags": [
                  "security",
                  "solidity",
                  "SWC-112",
                  "CWE-829"
                ],
                "precision": "medium"
              }
            },
            {
              "id": "SS-105",
              "name": "WeakOn-ChainRandomness",
              "shortDescription": {
                "text": "Weak On-Chain Randomness"
              },
              "fullDescription": {
                "text": "使用 block.timestamp、blockhash 等链上可观测值生成随机数，验证者或套利者可预测甚至影响结果。"
              },
              "helpUri": "https://swcregistry.io/docs/SWC-120",
              "properties": {
                "tags": [
                  "security",
                  "solidity",
                  "SWC-120",
                  "CWE-330"
                ],
                "precision": "medium"
              }
            },
            {
              "id": "SS-106",
              "name": "SelfdestructUsage",
              "shortDescription": {
                "text": "Selfdestruct Usage"
              },
              "fullDescription": {
                "text": "selfdestruct 会强制转移余额并删除代码，且在上海升级后语义发生变化，可能破坏代理、审计与资金安全假设。"
              },
              "helpUri": "https://swcregistry.io/docs/SWC-106",
              "properties": {
                "tags": [
                  "security",
                  "solidity",
                  "SWC-106",
                  "CWE-284"
                ],
                "precision": "medium"
              }
            },
            {
              "id": "SS-107",
              "name": "MissingAccessControl",
              "shortDescription": {
                "text": "Missing Access Control"
              },
              "fullDescription": {
                "text": "敏感管理函数为 public/external 且未见权限校验，任意地址均可调用并修改关键状态。"
              },
              "helpUri": "https://swcregistry.io/docs/SWC-105",
              "properties": {
                "tags": [
                  "security",
                  "solidity",
                  "SWC-105",
                  "CWE-284"
                ],
                "precision": "medium"
              }
            }
          ]
        }
      },
